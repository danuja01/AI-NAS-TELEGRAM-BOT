# Telegram Bot Token (Get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (Get from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Security - Allowed User IDs (comma-separated)
ALLOWED_USER_IDS=

# AI Models (2026 versions)
DEFAULT_MODEL=gpt-5.4-nano
THINKING_MODEL=o3
FALLBACK_MODEL=gpt-5.4-mini

# Internet Search API Keys (Optional - choose one)
SERPER_API_KEY=
TAVILY_API_KEY=your_tavily_api_key_here

# Root Access Password (Optional - for temporary root access feature)
ROOT_PASSWORD=your_secure_password_here

# Paths (Docker paths - don't change unless you know what you're doing)
DOCUMENT_PATH=/app/documents
ALLOWED_PATHS=/app/documents,/app/data
DATABASE_PATH=/app/data/bot.db
CHROMA_PATH=/app/data/chroma_db

# Conversation Settings
CONVERSATION_HISTORY_LENGTH=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/bot.log

# Read-only systemd/journal: allow any valid unit (ssh/sshd), not only MONITOR_SYSTEMD_UNITS
HOST_READONLY_SYSTEMD_ANY_UNIT=false
AGENT_HOST_READONLY_TOOL=false
AGENT_HOST_READONLY_EVALUATOR_MODE=false
AGENT_HOST_READ_EVALUATOR_RAG_ONLY=false
HOST_READ_EVALUATOR_MODEL=
