# Telegram Bot Token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# AI Models
DEFAULT_MODEL=gpt-5.4-nano
THINKING_MODEL=o3-mini
FALLBACK_MODEL=gpt-4o-mini

# Internet Search (optional - choose one)
SERPER_API_KEY=your_serper_key_here
TAVILY_API_KEY=your_tavily_key_here

# Ollama (optional - for lightweight fallback)
OLLAMA_URL=http://localhost:11434/api/generate

# Security
ALLOWED_USER_IDS=your_telegram_user_id_here
# NAS disk root (optional; used for elevated path allowlists in some deployments)
DISK_ROOT_PATH=
VISIBLE_ROOT_FOLDERS=documents,media,photos
# systemd units allowed for /restart_service (comma-separated; defaults to MONITOR_SYSTEMD_UNITS)
# RESTART_SERVICE_ALLOWED_UNITS=docker,smbd,nginx

# Paths
DOCUMENT_PATH=/srv/dev-disk-by-uuid-9ac22f70-05c6-442f-993b-0d9ca1ae5988/loo/loch/IELTS/
ALLOWED_PATHS=/srv/dev-disk-by-uuid-9ac22f70-05c6-442f-993b-0d9ca1ae5988/loo/loch/IELTS/,/home

# Conversation
CONVERSATION_HISTORY_LENGTH=10
# Max tool round-trips for /chat, /analyze, and agent-style /ask (each round may issue multiple tool calls)
AGENT_MAX_TOOL_ROUNDS=12
# Expose nas_host_readonly_profile to the AI: allow-listed read-only host diagnostics via SSH/nsenter (see services/readonly).
# Output can still contain sensitive paths or journal excerpts; keep false unless you trust the AI context.
AGENT_HOST_READONLY_TOOL=false

# Run `tailscale ip -4` when gathering /network stats (requires tailscale in PATH on the host/container).
NETWORK_TAILSCALE_CLI=true

# systemd: allow journal_tail + systemctl_is_active on ANY syntactically valid unit (ssh, sshd, …), not only MONITOR_SYSTEMD_UNITS.
# Read-only profiles only — still forbidden: apt_upgrade, arbitrary shell via this pipeline. Logs may leak secrets/tokens.
HOST_READONLY_SYSTEMD_ANY_UNIT=false

# Database
DATABASE_PATH=./data/bot.db
CHROMA_PATH=./data/chroma_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# RAG embeddings: openai (low RAM, uses API) or local (sentence-transformers + PyTorch; high RAM)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
# Include full slash-command list in every /ask prompt (false saves tokens)
RAG_INCLUDE_COMMAND_CATALOG=false
# RAG: re-index documents on every container start (false saves RAM/CPU on boot)
AUTO_INDEX_ON_START=false
# If true, wipes Chroma index before re-indexing (required after changing EMBEDDING_PROVIDER)
AUTO_INDEX_FORCE_REINDEX=false

# Host maintenance from bot (nsenter/SSH): separate timeout for omv-upgrade (seconds). 0 = wait until finished (no subprocess limit).
HOST_OMV_UPGRADE_TIMEOUT=7200

# OpenMediaVault read-only RPC via host `omv-rpc` (enriches /disk, /status, /smart, /hdddetail and AI tools).
# Requires HOST_EXEC_MODE=nsenter or ssh so the command runs on the OMV host.
OMV_RPC_USER=admin
OMV_RPC_ENABLED=true

# Docker storage (/d* commands)
STORAGE_CMD_TIMEOUT=120
STORAGE_SCAN_TIMEOUT=300
STORAGE_FIND_MIN_MB=500
STORAGE_LOG_MIN_MB=100
STORAGE_LOW_DISK_PERCENT=90
STORAGE_WEEKLY_SCAN_ENABLED=false
DOCKER_CLEAN_DRY_RUN_DEFAULT=false
# Docker health alerts: skip intentional stops (default) + optional ignore list
# unexpected_exit = only alert when a container was running then stops; all_exited = legacy (noisy)
MONITOR_DOCKER_ALERT_MODE=unexpected_exit
# Comma-separated container names to never alert on (exact match, case-insensitive)
# MONITOR_DOCKER_IGNORE=backup-sidecar,old-test-app
# Skip exited containers with restart policy no / unless-stopped / successful on-failure job
MONITOR_DOCKER_SKIP_INTENTIONAL_STOP=true
# STORAGE_SCAN_PATHS=/var/lib/docker,/var/log

# Autonomous troubleshooting: after health alerts, gather evidence + AI report (possibilities/risks only; no auto-fix)
AUTOTROUBLESHOOT_ENABLED=false
# Minimum alert severity to trigger AI triage: info | warning | critical
AUTOTROUBLESHOOT_MIN_SEVERITY=warning
# Cooldown per incident class (same alert types + max severity) before another AI report
AUTOTROUBLESHOOT_COOLDOWN_MINUTES=120
AUTOTROUBLESHOOT_MAX_ALERTS_PER_RUN=5
# Use THINKING_MODEL (o3-mini etc.) instead of AUTOTROUBLESHOOT_MODEL / DEFAULT_MODEL
AUTOTROUBLESHOOT_USE_THINKING=false
# AUTOTROUBLESHOOT_MODEL=gpt-4o-mini
AUTOTROUBLESHOOT_MAX_TOKENS=2500
AUTOTROUBLESHOOT_EVIDENCE_MAX_CHARS=12000
# Mark matching unacknowledged DB alerts after a report (reduces repeat scans)
AUTOTROUBLESHOOT_ACK_ALERTS=true
# Periodic scan for alerts missed while bot was down
AUTOTROUBLESHOOT_SCAN_UNACK=true
AUTOTROUBLESHOOT_UNACK_SCAN_HOURS=6
AUTOTROUBLESHOOT_UNACK_MAX_AGE_HOURS=24

# CrowdSec NAS Security Assistant (read-only cscli via docker exec; Telegram alerts + daily report)
CROWDSEC_MONITOR_ENABLED=false
# Inject CrowdSec security guidance into /chat and default agent tools when monitoring is on
CROWDSEC_SECURITY_ASSISTANT_IN_CHAT=true
CROWDSEC_CONTAINER=crowdsec
CROWDSEC_API_URL=http://127.0.0.1:8082
CROWDSEC_POLL_MINUTES=5
# Minimum severity for proactive Telegram alerts: LOW | MEDIUM | HIGH
CROWDSEC_ALERT_MIN_SEVERITY=MEDIUM
CROWDSEC_ALERT_COOLDOWN_MINUTES=60
CROWDSEC_SPIKE_THRESHOLD=8
CROWDSEC_SPIKE_WINDOW_MINUTES=15
CROWDSEC_DAILY_REPORT_HOUR=8

# Resource orchestrator: pause/stop low-priority containers when RAM/CPU spike (Immich ML, etc.)
RESOURCE_ORCHESTRATOR_ENABLED=false
RESOURCE_RAM_HIGH_PERCENT=85
RESOURCE_RAM_RECOVER_PERCENT=70
RESOURCE_CPU_HIGH_PERCENT=85
RESOURCE_CPU_RECOVER_PERCENT=50
RESOURCE_RAM_STAGE2_PERCENT=90
RESOURCE_CPU_STAGE2_PERCENT=90
RESOURCE_RECOVERY_DELAY_MINUTES=5
RESOURCE_CHECK_INTERVAL_SECONDS=30
RESOURCE_STAGE2_DELAY_SECONDS=60
RESOURCE_RESTORE_GAP_SECONDS=10
RESOURCE_IMMICH_ML_CPU_BOOST_PERCENT=50
# Stage 1 (pause) and stage 2 (stop) container names — comma-separated Docker names
# RESOURCE_CRITICAL_CONTAINERS=immich,immich_postgres,immich_redis,immich_machine_learning,tailscale,cloudflared,adguardhome,nas-telegram-bot
RESOURCE_PAUSE_CONTAINERS=affine,homarr,filebrowser
RESOURCE_STOP_CONTAINERS=jellyfin,sonarr,radarr,prowlarr,bazarr,jellyseerr,qbittorrent,flaresolverr

# Uptime Kuma-style monitoring (background probes + Telegram alerts)
UPTIME_MONITORING_ENABLED=true
UPTIME_TICK_SECONDS=30
UPTIME_DEFAULT_INTERVAL=60
UPTIME_BUILTIN_INTERNET=true
UPTIME_BUILTIN_DNS_HOST=1.1.1.1
UPTIME_BUILTIN_HTTP_URL=https://1.1.1.1
UPTIME_AUTO_DISCOVER_DOCKER=true
# false = no auto AI on DOWN alerts; use inline "AI assist" button (default)
UPTIME_AI_ON_INCIDENT=false
UPTIME_AI_BUTTON=true
UPTIME_WEEKLY_REPORT_ENABLED=true
# UPTIME_DASHBOARD_ENABLED=false
# UPTIME_DASHBOARD_SECRET=change-me-long-random
# UPTIME_SELF_HEAL_ENABLED=false
UPTIME_REBOOT_ALERT_ENABLED=true
UPTIME_BUILTIN_TAILSCALE=true
# Tailscale in Docker (no host CLI): set container name, probe via docker exec
UPTIME_TAILSCALE_PROBE=auto
UPTIME_TAILSCALE_CONTAINER=tailscale
UPTIME_TAILSCALE_SYNC_TARGET=true
UPTIME_BUILTIN_CLOUDFLARED=true
UPTIME_CLOUDFLARED_TARGET=process
UPTIME_DOCKER_IMAGE_ALERTS=true
UPTIME_DOCKER_IMAGE_SCAN_TICKS=120
UPTIME_ESCALATION_THRESHOLDS=1,3,10

# HTTP hook for cron, Watchtower, custom scripts (127.0.0.1 inside container)
# Enables HTTP hook (secret required for POST). Docker compose uses CRON_NOTIFY_BIND=0.0.0.0
# so host 127.0.0.1:18765 port publish works; do not expose 0.0.0.0:18765 on the LAN.
# CRON_NOTIFY_SECRET=long-random-string-at-least-24-chars
# CRON_NOTIFY_PORT=18765
# CRON_NOTIFY_BIND=0.0.0.0
CRON_NOTIFY_RATE_PER_MINUTE=30
